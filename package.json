{
  "name": "snote",
  "displayName": "SNote",
  "description": "Language support for hierarchical realtime persistent notes.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "snote",
        "aliases": [
          "SNote",
          "snote"
        ],
        "extensions": [
          ".snote"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snote",
        "scopeName": "source.snote",
        "path": "./syntaxes/snote.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "snote",
        "path": "./snippets/snote.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/snote.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.8.2"
  }
}