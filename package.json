{
  "name": "snote",
  "displayName": "SNote",
  "description": "Language support for hierarchical realtime persistent notes.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gh-Shinku/snote.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snote.toggleTodo",
        "title": "SNote: Toggle TODO item"
      }
    ],
    "keybindings": [
      {
        "command": "snote.toggleTodo",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == snote"
      }
    ],
    "languages": [
      {
        "id": "snote",
        "aliases": [
          "SNote",
          "snote"
        ],
        "extensions": [
          ".snote"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snote",
        "scopeName": "source.snote",
        "path": "./syntaxes/snote.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.typescriptreact": "typescriptreact",
          "meta.embedded.block.javascriptreact": "javascriptreact",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.markdown": "markdown"
        }
      },
      {
        "scopeName": "source.ocaml",
        "path": "./syntaxes/vendor/ocaml/ocaml.json"
      },
      {
        "scopeName": "source.ocaml.interface",
        "path": "./syntaxes/vendor/ocaml/ocaml.interface.json"
      },
      {
        "scopeName": "source.ocaml.ocamldoc",
        "path": "./syntaxes/vendor/ocaml/ocamldoc.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "generate:highlight": "node scripts/generate-highlighting.cjs",
    "check:highlight": "node scripts/generate-highlighting.cjs --check",
    "package": "npm run check:highlight && vsce package",
    "watch": "tsc -watch -p ./",
    "test": "npm run check:highlight && npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.8.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
