{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SNote",
  "scopeName": "source.snote",
  "patterns": [
    {
      "include": "#aside"
    },
    {
      "include": "#richText"
    },
    {
      "include": "#todo"
    },
    {
      "include": "#callTodo"
    },
    {
      "include": "#call"
    },
    {
      "include": "#ret"
    }
  ],
  "repository": {
    "aside": {
      "name": "meta.aside.snote",
      "begin": "^[ \\t]*(>)(?=[ \\t]|$)",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.aside.snote" }
      },
      "patterns": [{ "include": "#richText" }]
    },
    "richText": {
      "patterns": [
        {
          "name": "markup.inline.raw.snote",
          "match": "(`)([^`\\n]+)(`)",
          "captures": {
            "1": {
              "name": "punctuation.definition.raw.begin.snote"
            },
            "2": {
              "name": "markup.inline.raw.content.snote"
            },
            "3": {
              "name": "punctuation.definition.raw.end.snote"
            }
          }
        },
        {
          "name": "markup.bold.italic.snote",
          "match": "(\\*\\*\\*)([^*\\n]+)(\\*\\*\\*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.bold-italic.begin.snote"
            },
            "2": {
              "name": "markup.bold.italic.content.snote"
            },
            "3": {
              "name": "punctuation.definition.bold-italic.end.snote"
            }
          }
        },
        {
          "name": "markup.bold.snote",
          "match": "(\\*\\*)([^*\\n]+)(\\*\\*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.bold.begin.snote"
            },
            "2": {
              "name": "markup.bold.content.snote"
            },
            "3": {
              "name": "punctuation.definition.bold.end.snote"
            }
          }
        },
        {
          "name": "markup.italic.snote",
          "match": "(?<!\\*)(\\*)(?!\\*)([^*\\n]+)(?<!\\*)(\\*)(?!\\*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.italic.begin.snote"
            },
            "2": {
              "name": "markup.italic.content.snote"
            },
            "3": {
              "name": "punctuation.definition.italic.end.snote"
            }
          }
        },
        {
          "name": "markup.strikethrough.snote",
          "match": "(~~)([^~\\n]+)(~~)",
          "captures": {
            "1": {
              "name": "punctuation.definition.strikethrough.begin.snote"
            },
            "2": {
              "name": "markup.strikethrough.content.snote"
            },
            "3": {
              "name": "punctuation.definition.strikethrough.end.snote"
            }
          }
        }
      ]
    },
    "todo": {
      "patterns": [
        {
          "name": "meta.todo.unchecked.snote",
          "match": "^(\\s*)(-\\s+)(\\[ \\])(?:([ \\t]+)(\\[P[123]\\])(?=[ \\t]|$))?(.*)$",
          "captures": {
            "3": {
              "name": "punctuation.definition.todo.unchecked.snote"
            },
            "5": { "name": "meta.todo.priority.snote" }
          }
        },
        {
          "name": "meta.todo.checked.snote",
          "match": "^(\\s*)(-\\s+)(\\[[xX]\\])(?:([ \\t]+)(\\[P[123]\\])(?=[ \\t]|$))?(.*)$",
          "captures": {
            "3": {
              "name": "punctuation.definition.todo.checked.snote"
            },
            "5": { "name": "meta.todo.priority.snote" }
          }
        }
      ]
    },
    "callTodo": {
      "patterns": [
        {
          "name": "meta.call.todo.unchecked.snote",
          "match": "^(\\s*)(call)(\\s+)(\\[ \\])(\\s+)(?:(\\[P[123]\\])([ \\t]+))?(\\S(?:.*\\S)?)(\\s*)(:)\\s*$",
          "captures": {
            "2": { "name": "keyword.control.call.snote" },
            "4": { "name": "punctuation.definition.todo.unchecked.snote" },
            "6": { "name": "meta.todo.priority.snote" },
            "8": { "name": "string.unquoted.title.snote" },
            "10": { "name": "punctuation.definition.block.snote" }
          }
        },
        {
          "name": "meta.call.todo.checked.snote",
          "match": "^(\\s*)(call)(\\s+)(\\[[xX]\\])(\\s+)(?:(\\[P[123]\\])([ \\t]+))?(\\S(?:.*\\S)?)(\\s*)(:)\\s*$",
          "captures": {
            "2": { "name": "keyword.control.call.snote" },
            "4": { "name": "punctuation.definition.todo.checked.snote" },
            "6": { "name": "meta.todo.priority.snote" },
            "8": { "name": "string.unquoted.title.snote" },
            "10": { "name": "punctuation.definition.block.snote" }
          }
        }
      ]
    },
    "call": {
      "name": "meta.call.snote",
      "match": "^(\\s*)(call)(\\s+)(.*)(:)\\s*$",
      "captures": {
        "2": {
          "name": "keyword.control.call.snote"
        },
        "4": {
          "name": "string.unquoted.title.snote"
        },
        "5": {
          "name": "punctuation.definition.block.snote"
        }
      }
    },
    "ret": {
      "name": "meta.ret.snote",
      "match": "^\\s*(ret)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.ret.snote"
        }
      }
    }
  }
}
