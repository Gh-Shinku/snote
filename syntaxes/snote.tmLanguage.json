{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SNote",
  "scopeName": "source.snote",
  "patterns": [
    {
      "include": "#fencedCode"
    },
    {
      "include": "#richText"
    },
    {
      "include": "#todo"
    },
    {
      "include": "#call"
    },
    {
      "include": "#ret"
    }
  ],
  "repository": {
    "fencedCode": {
      "patterns": [
        {
          "name": "markup.fenced_code.block.snote",
          "begin": "^\\s*(`{3,})\\s*(?i:(js|javascript|mjs|cjs))(?:\\s+[^`]*)?$",
          "end": "^\\s*(\\1`*)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.fence.begin.snote"
            },
            "2": {
              "name": "fenced_code.block.language.snote"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.fence.end.snote"
            }
          },
          "contentName": "meta.embedded.block.javascript",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
